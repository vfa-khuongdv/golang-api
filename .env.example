# =============================================================================
# Golang CMS API — Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env

# ── App ─────────────────────────────────────────────────────────────────────
APP_SERVICE=golang-cms
APP_VERSION=dev

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
GIN_MODE=release
STAGE=dev

# ── Database ────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=golang_cms

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_KEY=change-me-to-a-secret-at-least-32-chars-long!!

# ── Mail ────────────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Proxy ───────────────────────────────────────────────────────────────────
# Comma-separated CIDRs of trusted reverse proxies / load balancers.
# Leave EMPTY when the app is exposed directly (recommended) so that the
# X-Forwarded-For header cannot spoof the client IP used by the rate limiter.
# Set to e.g. "10.0.0.0/8" when running behind a reverse proxy.
TRUSTED_PROXIES=

# ── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Migration ───────────────────────────────────────────────────────────────
RUN_MIGRATE=true
