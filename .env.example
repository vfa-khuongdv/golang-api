# =============================================================================
# Golang CMS API — Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env

# ── App ─────────────────────────────────────────────────────────────────────
APP_SERVICE=golang-cms
APP_VERSION=dev

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
GIN_MODE=release
STAGE=dev

# ── Database ────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=golang_cms

# ── JWT ─────────────────────────────────────────────────────────────────────
# With STAGE=prod the server refuses to start while a secret still starts with
# "change-me". Generate one with: openssl rand -base64 48
JWT_KEY=change-me-to-a-secret-at-least-32-chars-long!!

# ── Settings encryption ─────────────────────────────────────────────────────
# Encrypts secret rows of the settings table (e.g. mail.password). At least 32
# characters. Changing it makes existing encrypted values unreadable.
# Generate one with: openssl rand -base64 48
SETTINGS_ENCRYPTION_KEY=change-me-to-a-random-key-at-least-32-chars!!

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Proxy ───────────────────────────────────────────────────────────────────
# Comma-separated CIDRs of trusted reverse proxies / load balancers. The client
# IP (rate limiter key, stored on refresh tokens) is read from X-Forwarded-For
# when the request comes from one of them.
# Default 0.0.0.0/0 trusts every peer: works behind an AWS ALB without knowing its
# IPs, but a client can spoof X-Forwarded-For and dodge the per-IP rate limit.
# Safer: set the proxy CIDR, e.g. the VPC CIDR "10.0.0.0/16". With STAGE=prod
# and TRUSTED_PROXIES unset, the server logs a warning at startup.
# Set EMPTY when the app is exposed directly with no proxy (nothing is trusted).
TRUSTED_PROXIES=0.0.0.0/0

# ── Seeder ──────────────────────────────────────────────────────────────────
# Password of the sample users created by cmd/seeder (the first one is an
# admin). Defaults to "password123" outside prod; required when STAGE=prod.
# SEED_USER_PASSWORD=

# ── Migration ───────────────────────────────────────────────────────────────
RUN_MIGRATE=true
